{
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [
    8000,
    5173
  ],
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "name": "NEXUS",
  "portsAttributes": {
    "5173": {
      "label": "NEXUS console",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "NEXUS API",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "curl -sSL https://install.python-poetry.org | python3 - && export PATH=\"$HOME/.local/bin:$PATH\" && cd nexus-backend && poetry install --no-root || true; cd ../frontend && npm install || true",
  "remoteUser": "vscode"
}