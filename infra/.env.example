# NEXUS secrets for docker compose. Copy to infra/.env (or let
# scripts/start-nexus.sh generate one with random values).
# NEVER commit infra/.env — it holds real secrets (it is ignored via
# the `.env` rule in .gitignore).
#
# If the stack already has a postgres_data volume, the database was
# initialized with whatever password was in effect then. Put THAT
# password here or Postgres will refuse to start; rotate it separately
# (see docs/security.md) — never by editing docker-compose.yml.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
SECRET_KEY=change-me-to-a-long-random-secret
